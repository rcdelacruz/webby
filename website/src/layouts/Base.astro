---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { GITHUB, RELEASES, PLATFORMS, REPO } from "../data/site";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const preview = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";
const links = [
  { href: "/download/", text: "Download" },
  { href: "/docs/", text: "Docs" },
  { href: "/changelog/", text: "Changelog" },
];
const suffixes = Object.fromEntries(PLATFORMS.map(p => [p.key, p.suffix]));
const names = Object.fromEntries(PLATFORMS.map(p => [p.key, p.name]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav-row">
        <a class="brand" href="/" aria-label="webby home"><img src="/wordmark.svg" alt="webby" width="84" height="26" /></a>
        <nav class="nav-links" aria-label="Main">
          {links.map(link => <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>{link.text}</a>)}
        </nav>
        <a class="btn btn-ghost btn-small" href={GITHUB} rel="noopener" aria-label="webby on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-row">
        <img src="/wordmark.svg" alt="webby" width="72" height="23" />
        <nav aria-label="Footer">
          <a href="/download/">Download</a>
          <a href="/docs/">Docs</a>
          <a href="/changelog/">Changelog</a>
          <a href={GITHUB} rel="noopener">GitHub</a>
          <a href={RELEASES} rel="noopener">Releases</a>
          <a href={`${GITHUB}/issues`} rel="noopener">Issues</a>
        </nav>
        <p>
          webby is open source under the <a href={`${GITHUB}/blob/main/LICENSE`} rel="noopener">MIT License</a>. WebKit is a trademark of Apple Inc. webby is an independent project and is not affiliated with
          Apple.
        </p>
      </div>
    </footer>

    <script is:inline define:vars={{ repo: REPO, suffixes, names }}>
      // Point the download buttons at the visitor's system, and at the exact
      // files of the latest release when GitHub's API is reachable. Without
      // JavaScript, or if the request fails, every button still leads to the
      // releases page and the version shown is the one the site was built for.
      (() => {
        const ua = navigator.userAgent;
        const mobile = /Android|iPhone|iPad|iPod/i.test(ua);
        const os = mobile ? null : /Windows/i.test(ua) ? "windows" : /Mac OS X|Macintosh/i.test(ua) ? "macos" : /Linux|X11/i.test(ua) ? "linux" : null;
        const each = (selector, fn) => document.querySelectorAll(selector).forEach(fn);

        // Ease sections in as they are scrolled to.
        const targets = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          const seen = new IntersectionObserver(
            entries =>
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("in");
                  seen.unobserve(entry.target);
                }
              }),
            { rootMargin: "0px 0px -8% 0px" },
          );
          targets.forEach(el => seen.observe(el));
        } else {
          targets.forEach(el => el.classList.add("in"));
        }

        if (os) {
          each("[data-download-label]", el => (el.textContent = `Download for ${names[os]}`));
          each(`[data-os="${os}"]`, el => el.classList.add("current"));
        }

        fetch(`https://api.github.com/repos/${repo}/releases/latest`, { headers: { Accept: "application/vnd.github+json" } })
          .then(response => (response.ok ? response.json() : Promise.reject(response.status)))
          .then(release => {
            const version = String(release.tag_name || "").replace(/^v/, "").replace(/-.*$/, "");
            if (version) each("[data-version]", el => (el.textContent = version));
            const found = {};
            for (const [key, suffix] of Object.entries(suffixes)) {
              const match = (release.assets || []).find(asset => asset.name.endsWith(suffix));
              if (match) found[key] = match.browser_download_url;
            }
            each("[data-asset]", el => {
              if (found[el.dataset.asset]) el.href = found[el.dataset.asset];
            });
            if (os && found[os]) each("[data-download]", el => (el.href = found[os]));
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
