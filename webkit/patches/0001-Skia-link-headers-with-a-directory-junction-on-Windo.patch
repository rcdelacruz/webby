From 8a7df8fdb2a1bfa7987ffbf3ca06c90f5b0f9ab5 Mon Sep 17 00:00:00 2001
From: webby <webby@localhost>
Date: Wed, 25 Nov 2026 11:37:59 +0800
Subject: [PATCH 1/8] Skia: link headers with a directory junction on Windows

---
 Source/ThirdParty/skia/CMakeLists.txt | 30 ++++++++++++++++++---------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/Source/ThirdParty/skia/CMakeLists.txt b/Source/ThirdParty/skia/CMakeLists.txt
index 849b3ef2ee..32188c0f28 100644
--- a/Source/ThirdParty/skia/CMakeLists.txt
+++ b/Source/ThirdParty/skia/CMakeLists.txt
@@ -1006,19 +1006,29 @@ target_include_directories(Skia
         "${Skia_FRAMEWORK_HEADERS_DIR}/mod"
 )
 
+# Link the headers into a skia/ prefix. On Windows a symbolic link needs a
+# privilege that ordinary accounts lack, so a directory junction is used.
+function(SKIA_LINK_HEADERS _target _link)
+    if (WIN32)
+        if (NOT EXISTS "${_link}")
+            file(TO_NATIVE_PATH "${_link}" _native_link)
+            file(TO_NATIVE_PATH "${_target}" _native_target)
+            execute_process(COMMAND cmd /c mklink /J "${_native_link}" "${_native_target}"
+                OUTPUT_QUIET RESULT_VARIABLE _result)
+            if (NOT _result EQUAL 0)
+                message(FATAL_ERROR "Could not create a junction ${_link} -> ${_target}")
+            endif ()
+        endif ()
+    else ()
+        file(CREATE_LINK "${_target}" "${_link}" SYMBOLIC)
+    endif ()
+endfunction()
+
 file(MAKE_DIRECTORY "${Skia_FRAMEWORK_HEADERS_DIR}/top")
-file(CREATE_LINK
-    "${CMAKE_CURRENT_SOURCE_DIR}/include"
-    "${Skia_FRAMEWORK_HEADERS_DIR}/top/skia"
-    SYMBOLIC
-)
+SKIA_LINK_HEADERS("${CMAKE_CURRENT_SOURCE_DIR}/include" "${Skia_FRAMEWORK_HEADERS_DIR}/top/skia")
 
 file(MAKE_DIRECTORY "${Skia_FRAMEWORK_HEADERS_DIR}/mod/skia/modules")
-file(CREATE_LINK
-    "${CMAKE_CURRENT_SOURCE_DIR}/modules/svg/include"
-    "${Skia_FRAMEWORK_HEADERS_DIR}/mod/skia/modules/svg"
-    SYMBOLIC
-)
+SKIA_LINK_HEADERS("${CMAKE_CURRENT_SOURCE_DIR}/modules/svg/include" "${Skia_FRAMEWORK_HEADERS_DIR}/mod/skia/modules/svg")
 
 target_compile_definitions(Skia PRIVATE
     SKIA_IMPLEMENTATION=1
