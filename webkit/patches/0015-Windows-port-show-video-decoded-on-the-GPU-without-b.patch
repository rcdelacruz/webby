+#if OS(WINDOWS) && USE(GRAPHICS_LAYER_WC)
+struct MediaPlayerPrivateGStreamer::SharedVideoTextures {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(SharedVideoTextures);
+
+    // The compositor may still be showing the texture written last or the one before it.
+    // Going round four leaves two that are certainly free.
+    static constexpr unsigned count = 4;
+
+    ~SharedVideoTextures()
+    {
+        if (!device)
+            return;
+        // Release the Direct3D objects while holding the lock of the device they belong to,
+        // and before the device itself.
+        gst_d3d11_device_lock(device);
+        copyDone.Reset();
+        for (auto& texture : textures)
+            texture.Reset();
+        gst_d3d11_device_unlock(device);
+        gst_object_unref(device);
+    }
+
+    GstD3D11Device* device { nullptr };
+    std::array<Microsoft::WRL::ComPtr<ID3D11Texture2D>, count> textures;
+    std::array<HANDLE, count> handles { };
+    Microsoft::WRL::ComPtr<ID3D11Query> copyDone;
+    IntSize size;
+    unsigned next { 0 };
+    uint64_t generation { 0 };
+};
+
+// Out of line, and after the definition of SharedVideoTextures: the destructor of the player
+// comes before it in this file, where the type is still incomplete and cannot be deleted.
+void MediaPlayerPrivateGStreamer::destroySharedVideoTextures()
+{
+    Locker locker { m_sharedVideoTextureLock };
+    delete std::exchange(m_sharedVideoTextures, nullptr);
+    m_currentSharedVideoTexture = { };
+}
+
+bool MediaPlayerPrivateGStreamer::copySampleToSharedTexture(GstSample* sample)
+{
+    auto* buffer = gst_sample_get_buffer(sample);
+    auto* caps = gst_sample_get_caps(sample);
+    if (!buffer || !caps)
+        return false;
+
+    auto* memory = gst_buffer_peek_memory(buffer, 0);
+    if (!memory || !gst_is_d3d11_memory(memory))
+        return false;
+
+    GstVideoInfo info;
+    if (!gst_video_info_from_caps(&info, caps) || GST_VIDEO_INFO_FORMAT(&info) != GST_VIDEO_FORMAT_BGRA)
+        return false;
+
+    auto* device = GST_D3D11_MEMORY_CAST(memory)->device;
+    auto* d3dDevice = gst_d3d11_device_get_device_handle(device);
+    auto* context = gst_d3d11_device_get_device_context_handle(device);
+    IntSize size { GST_VIDEO_INFO_WIDTH(&info), GST_VIDEO_INFO_HEIGHT(&info) };
+    if (size.isEmpty())
+        return false;
+
+    Locker locker { m_sharedVideoTextureLock };
+    if (!m_sharedVideoTextures || m_sharedVideoTextures->device != device || m_sharedVideoTextures->size != size) {
+        static std::atomic<uint64_t> lastGeneration { 0 };
+        auto textures = makeUnique<SharedVideoTextures>();
+        D3D11_TEXTURE2D_DESC description { };
+        description.Width = size.width();
+        description.Height = size.height();
+        description.MipLevels = 1;
+        description.ArraySize = 1;
+        description.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        description.SampleDesc.Count = 1;
+        description.Usage = D3D11_USAGE_DEFAULT;
+        description.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+        description.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+        for (unsigned i = 0; i < SharedVideoTextures::count; ++i) {
+            Microsoft::WRL::ComPtr<IDXGIResource> resource;
+            if (FAILED(d3dDevice->CreateTexture2D(&description, nullptr, &textures->textures[i]))
+                || FAILED(textures->textures[i].As(&resource))
+                || FAILED(resource->GetSharedHandle(&textures->handles[i])) || !textures->handles[i]) {
+                delete std::exchange(m_sharedVideoTextures, nullptr);
+                return false;
+            }
+        }
+        D3D11_QUERY_DESC queryDescription { D3D11_QUERY_EVENT, 0 };
+        d3dDevice->CreateQuery(&queryDescription, &textures->copyDone);
+        textures->device = GST_D3D11_DEVICE(gst_object_ref(device));
+        textures->size = size;
+        textures->generation = ++lastGeneration;
+        delete std::exchange(m_sharedVideoTextures, textures.release());
+    }
+
+    auto& textures = *m_sharedVideoTextures;
+    unsigned index = textures.next;
+    textures.next = (index + 1) % SharedVideoTextures::count;
+
+    // Mapping with GST_MAP_D3D11 brings the texture up to date. The device lock is the one the
+    // decoder and the converter, on their own threads, take around their use of the context.
+    GstMapInfo mapInfo;
+    if (!gst_memory_map(memory, &mapInfo, static_cast<GstMapFlags>(GST_MAP_READ | GST_MAP_D3D11)))
+        return false;
+    auto* source = reinterpret_cast<ID3D11Resource*>(mapInfo.data);
+    D3D11_BOX box { 0, 0, 0, static_cast<UINT>(size.width()), static_cast<UINT>(size.height()), 1 };
+    gst_d3d11_device_lock(device);
+    context->CopySubresourceRegion(textures.textures[index].Get(), 0, 0, 0, 0, source, gst_d3d11_memory_get_subresource_index(GST_D3D11_MEMORY_CAST(memory)), &box);
+    if (textures.copyDone)
+        context->End(textures.copyDone.Get());
+    context->Flush();
+    gst_d3d11_device_unlock(device);
+    gst_memory_unmap(memory, &mapInfo);
+
+    // The compositor is another process with a queue to the GPU of its own, and could draw the
+    // texture before the copy into it has run. Wait for the copy; it takes well under a
+    // millisecond.
+    if (textures.copyDone) {
+        for (unsigned attempt = 0; attempt < 100; ++attempt) {
+            gst_d3d11_device_lock(device);
+            auto result = context->GetData(textures.copyDone.Get(), nullptr, 0, 0);
+            gst_d3d11_device_unlock(device);
+            if (result != S_FALSE)
+                break;
+            if (attempt < 20)
+                ::SwitchToThread();
+            else
+                ::Sleep(1);
+        }
+    }
+
+    m_currentSharedVideoTexture = { static_cast<uint64_t>(reinterpret_cast<uintptr_t>(textures.handles[index])), textures.generation, size };
+    return true;
+}
