 #include <wtf/RefPtr.h>
@@ -52,14 +53,35 @@ public:
     void setImage(RefPtr<NativeImage>&& image)
     {
         m_image = WTF::move(image);
+        m_sharedTexture = { };
         if (auto* layerClient = client())
             layerClient->setPlatformLayerNeedsDisplay();
     }
 
     NativeImage* image() const { return m_image.get(); }
 
+    // Instead of an image, a Direct3D texture the compositor opens by its share handle and
+    // draws as it is, so that a video frame decoded on the GPU never leaves it. The
+    // generation tells apart textures whose handles happen to have the same value.
+    struct SharedTexture {
+        uint64_t handle { 0 };
+        uint64_t generation { 0 };
+        IntSize size;
+    };
+
+    void setSharedTexture(const SharedTexture& texture)
+    {
+        m_sharedTexture = texture;
+        m_image = nullptr;
+        if (auto* layerClient = client())
+            layerClient->setPlatformLayerNeedsDisplay();
+    }
+
+    const SharedTexture& sharedTexture() const { return m_sharedTexture; }
+
 private:
     RefPtr<NativeImage> m_image;
+    SharedTexture m_sharedTexture;
 };
 
