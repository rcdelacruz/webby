+/*
+ * GStreamer's Direct3D 11 library includes <gst/d3d11/gstd3d11config.h>, a header its build
+ * generates. The vcpkg port of GStreamer does not install it, so the values of a desktop
+ * (not UWP) build are given here, where the include path for this directory finds them.
+ */
+
+#pragma once
+
+#include <gst/gst.h>
+
+G_BEGIN_DECLS
+
+#define GST_D3D11_WINAPI_ONLY_APP 0
+#define GST_D3D11_WINAPI_APP 1
+
+G_END_DECLS
