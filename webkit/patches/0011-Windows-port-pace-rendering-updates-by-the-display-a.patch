+// Without this a page assumes a 60Hz display and updates no more than 60 times a second.
+std::optional<WebCore::FramesPerSecond> DrawingAreaProxyWC::displayNominalFramesPerSecond()
+{
+    DWM_TIMING_INFO info { };
+    info.cbSize = sizeof(info);
+    if (FAILED(::DwmGetCompositionTimingInfo(nullptr, &info)) || !info.rateRefresh.uiDenominator)
+        return std::nullopt;
+    auto rate = std::lround(static_cast<double>(info.rateRefresh.uiNumerator) / info.rateRefresh.uiDenominator);
+    if (rate < 24 || rate > 1000)
+        return std::nullopt;
+    return static_cast<WebCore::FramesPerSecond>(rate);
+}
+
 DrawingAreaProxyWC::DrawingAreaProxyWC(WebPageProxy& webPageProxy, WebProcessProxy& webProcessProxy)
     : DrawingAreaProxy(webPageProxy, webProcessProxy)
 {
