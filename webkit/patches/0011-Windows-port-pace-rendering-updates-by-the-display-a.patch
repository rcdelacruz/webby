--- a/Source/WebCore/platform/graphics/win/DisplayRefreshMonitorWin.cpp
+++ b/Source/WebCore/platform/graphics/win/DisplayRefreshMonitorWin.cpp
@@ -26,10 +26,27 @@
 #include "config.h"
 #include "DisplayRefreshMonitorWin.h"
 
+#include <dwmapi.h>
+#include <wtf/MainThread.h>
+#include <wtf/Threading.h>
+#include <wtf/ThreadSafeWeakPtr.h>
+
 namespace WebCore {
 
 constexpr FramesPerSecond DefaultFramesPerSecond = 60;
 
+static FramesPerSecond displayRefreshRate()
+{
+    DWM_TIMING_INFO info { };
+    info.cbSize = sizeof(info);
+    if (SUCCEEDED(::DwmGetCompositionTimingInfo(nullptr, &info)) && info.rateRefresh.uiDenominator) {
+        auto rate = std::lround(static_cast<double>(info.rateRefresh.uiNumerator) / info.rateRefresh.uiDenominator);
+        if (rate >= 24 && rate <= 1000)
+            return rate;
+    }
+    return DefaultFramesPerSecond;
+}
+
 RefPtr<DisplayRefreshMonitorWin> DisplayRefreshMonitorWin::create(PlatformDisplayID displayID)
 {
     return adoptRef(*new DisplayRefreshMonitorWin(displayID));
@@ -37,28 +54,85 @@ RefPtr<DisplayRefreshMonitorWin> DisplayRefreshMonitorWin::create(PlatformDispla
 
 DisplayRefreshMonitorWin::DisplayRefreshMonitorWin(PlatformDisplayID displayID)
     : DisplayRefreshMonitor(displayID)
-    , m_timer(RunLoop::mainSingleton(), "DisplayRefreshMonitorWin::Timer"_s, this, &DisplayRefreshMonitorWin::displayLinkCallbackFired)
-    , m_currentUpdate({ 0, DefaultFramesPerSecond })
+    , m_state(adoptRef(*new VSyncState))
 {
+    {
+        Locker locker { m_state->lock };
+        m_state->currentUpdate = { 0, displayRefreshRate() };
+    }
+    // A client that wants fewer updates than the display makes (60 a second on a 120Hz display,
+    // or a throttled page) skips some refreshes without asking again. Keep going through those
+    // rather than stopping at the first refresh nobody took.
+    Locker locker { lock() };
+    setMaxUnscheduledFireCount(20);
 }
 
-void DisplayRefreshMonitorWin::displayLinkCallbackFired()
+DisplayRefreshMonitorWin::~DisplayRefreshMonitorWin()
 {
-    displayLinkFired(m_currentUpdate);
-    m_currentUpdate = m_currentUpdate.nextUpdate();
+    Locker locker { m_state->lock };
+    m_state->shutdown = true;
+    m_state->condition.notifyAll();
 }
 
+// Rendering updates used to be paced by a 16ms run loop timer. That drifts against the display,
+// so frames reached the screen unevenly, and a timer cannot follow a display that is not 60Hz.
+// DwmFlush() returns when the desktop compositor has presented, once per refresh of the display.
 bool DisplayRefreshMonitorWin::startNotificationMechanism()
 {
-    if (!m_timer.isActive())
-        m_timer.startRepeating(16_ms);
+    Locker locker { m_state->lock };
+    m_state->active = true;
+    m_state->condition.notifyAll();
+    if (m_didStartThread)
+        return true;
+    m_didStartThread = true;
+
+    Thread::create("DisplayRefreshMonitorWin"_s, [state = m_state, weakThis = ThreadSafeWeakPtr { *this }] {
+        while (true) {
+            FramesPerSecond rate;
+            {
+                Locker locker { state->lock };
+                while (!state->active && !state->shutdown)
+                    state->condition.wait(state->lock);
+                if (state->shutdown)
+                    return;
+                rate = state->currentUpdate.updatesPerSecond;
+            }
 
+            if (FAILED(::DwmFlush()))
+                ::Sleep(1000 / rate);
+
+            DisplayUpdate update;
+            {
+                Locker locker { state->lock };
+                if (!state->active || state->shutdown)
+                    continue;
+                update = state->currentUpdate;
+                state->currentUpdate = update.nextUpdate();
+            }
+
+            RefPtr monitor = weakThis.get();
+            if (!monitor)
+                return;
+            monitor->displayLinkFired(update);
+            // The monitor belongs to the main thread; do not let this thread drop the last reference.
+            callOnMainThread([monitor = WTF::move(monitor)] { });
+        }
+    })->detach();
     return true;
 }
 
+void DisplayRefreshMonitorWin::dispatchDisplayDidRefresh(const DisplayUpdate& update)
+{
+    // Called on the thread that waits for the display.
+    callOnMainThread([protectedThis = Ref { *this }, update] {
+        protectedThis->displayDidRefresh(update);
+    });
+}
+
 void DisplayRefreshMonitorWin::stopNotificationMechanism()
 {
-    m_timer.stop();
+    Locker locker { m_state->lock };
+    m_state->active = false;
 }
 
 } // namespace WebCore
