+#if !USE(GLIB_EVENT_LOOP)
+// A bus signal watch is a GLib main loop source, and nothing runs a GLib main loop
+// in this configuration. Each message is instead handed, as it is posted, to the run
+// loop of the thread that asked for the watch, where it is emitted as a "message"
+// signal just as the watch would have done.
+static GQuark busRunLoopWatchQuark()
+{
+    static GQuark quark = g_quark_from_static_string("webkit-bus-run-loop-watch");
+    return quark;
+}
+
+static void addBusSignalWatchOnRunLoop(GstBus* bus)
+{
+    gst_bus_enable_sync_message_emission(bus);
+
+    SUPPRESS_UNCOUNTED_LOCAL auto* runLoop = &RunLoop::currentSingleton();
+    runLoop->ref();
+    auto handler = g_signal_connect_data(bus, "sync-message", G_CALLBACK(+[](GstBus* bus, GstMessage* message, gpointer userData) {
+        auto& runLoop = *static_cast<RunLoop*>(userData);
+        runLoop.dispatch([bus = GRefPtr<GstBus>(bus), message = GRefPtr<GstMessage>(message)] {
+            gst_bus_async_signal_func(bus.get(), message.get(), nullptr);
+            // The bus also queues every message for a watch that does not exist.
+            while (auto queuedMessage = adoptGRef(gst_bus_pop(bus.get()))) { }
+        });
+    }), runLoop, +[](gpointer userData, GClosure*) {
+        static_cast<RunLoop*>(userData)->deref();
+    }, static_cast<GConnectFlags>(0));
+    g_object_set_qdata(G_OBJECT(bus), busRunLoopWatchQuark(), GUINT_TO_POINTER(handler));
+}
+
+static void removeBusSignalWatchOnRunLoop(GstBus* bus)
+{
+    auto handler = GPOINTER_TO_UINT(g_object_get_qdata(G_OBJECT(bus), busRunLoopWatchQuark()));
+    if (!handler)
+        return;
+
+    g_signal_handler_disconnect(bus, handler);
+    gst_bus_disable_sync_message_emission(bus);
+    g_object_set_qdata(G_OBJECT(bus), busRunLoopWatchQuark(), nullptr);
+}
+#endif // !USE(GLIB_EVENT_LOOP)
