+// software. The fallback sink paints BGRx or BGRA from system memory, and reaching that
+// format in videoconvert costs far more than a frame lasts. This wraps the sink so that
+// the conversion happens on the GPU and only the result is downloaded.
+static GstElement* wrapVideoSinkWithD3D11Conversion(GstElement* sink)
+{
+    GRefPtr upload = gst_element_factory_make("d3d11upload", nullptr);
+    GRefPtr convert = gst_element_factory_make("d3d11convert", nullptr);
+    GRefPtr filter = gst_element_factory_make("capsfilter", nullptr);
+    GRefPtr download = gst_element_factory_make("d3d11download", nullptr);
+    if (!upload || !convert || !filter || !download)
+        return nullptr;
+
+    // sRGB, so that the image made from a frame is in the colour space pages are painted
+    // in and drawing it needs no conversion of each pixel on the CPU.
+    GRefPtr caps = adoptGRef(gst_caps_from_string("video/x-raw(memory:D3D11Memory), format=(string){ BGRx, BGRA }, colorimetry=(string)sRGB"));
+    g_object_set(filter.get(), "caps", caps.get(), nullptr);
