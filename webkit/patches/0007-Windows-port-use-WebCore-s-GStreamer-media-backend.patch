+// The spatialization impulse responses ship as WebKit.resources\audio\*.wav.
+RefPtr<AudioBus> AudioBus::loadPlatformResource(StringView name, float sampleRate)
+{
+    auto data = FileSystem::readEntireFile(webKitBundlePath(name, "wav"_s, "audio"_s));
