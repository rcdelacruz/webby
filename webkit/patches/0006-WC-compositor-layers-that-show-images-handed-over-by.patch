+// A platform layer that supplies images, such as a video's, says so when it has a new one.
+void GraphicsLayerWC::setImagePlatformLayerClient(WebCore::TextureMapperPlatformLayer::Client* client)
+{
+    if (m_platformLayer && static_cast<WebCore::WCPlatformLayer*>(m_platformLayer)->isImageLayer())
+        m_platformLayer->setClient(client);
+}
+
+void GraphicsLayerWC::platformLayerWillBeDestroyed()
+{
+    m_platformLayer = nullptr;
+    noteLayerPropertyChanged(WCLayerChange::PlatformLayer);
+}
+
+void GraphicsLayerWC::setPlatformLayerNeedsDisplay()
+{
+    setContentsNeedsDisplay();
+}
