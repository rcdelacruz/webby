 WTF_MAKE_TZONE_ALLOCATED_IMPL(WCScene);
 
+// The contents of a layer that shows images supplied by the web process, such as the
+// frames of a video: one texture, replaced when a new image arrives and scaled by the
+// compositor.
+class WCImageLayerContents final : public WebCore::TextureMapperPlatformLayer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(WCImageLayerContents);
+public:
+    void setImage(WebCore::ShareableBitmap& bitmap)
+    {
+        RefPtr image = WebCore::NativeImage::create(bitmap.createPlatformImage(WebCore::BackingStoreCopy::DontCopyBackingStore));
+        if (!image)
+            return;
+
+        auto size = image->size();
+        if (!m_texture || m_texture->size() != size)
+            m_texture = WebCore::BitmapTexture::create(size);
+        m_texture->updateContents(image.get(), WebCore::IntRect { { }, size }, { });
+    }
+
+private:
+    void paintToTextureMapper(WebCore::TextureMapper& textureMapper, const WebCore::FloatRect& targetRect, const WebCore::TransformationMatrix& modelViewMatrix, float opacity) final
+    {
+        if (m_texture)
+            textureMapper.drawTexture(*m_texture, targetRect, modelViewMatrix, opacity);
+    }
+
+    RefPtr<WebCore::BitmapTexture> m_texture;
+};
