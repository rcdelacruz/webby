+#pragma once
+
+#include "NativeImage.h"
+#include "WCPlatformLayer.h"
+#include <wtf/RefPtr.h>
+
+namespace WebCore {
+
+// A layer whose contents are images WebCore hands over one at a time, such as the
+// frames of a video. The compositor shows the latest image as a texture of its own,
+// so a new frame costs one upload and no repaint of the page around it.
+// Used on the main thread only.
+class WCPlatformLayerImage final : public WCPlatformLayer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(WCPlatformLayerImage);
+public:
+    ~WCPlatformLayerImage()
+    {
+        if (auto* layerClient = client())
+            layerClient->platformLayerWillBeDestroyed();
+    }
+
+    bool isImageLayer() const final { return true; }
+
+    // True once a graphics layer shows this layer's contents.
+    bool isAttached() { return !!client(); }
+
+    void setImage(RefPtr<NativeImage>&& image)
+    {
+        m_image = WTF::move(image);
+        if (auto* layerClient = client())
+            layerClient->setPlatformLayerNeedsDisplay();
+    }
+
+    NativeImage* image() const { return m_image.get(); }
+
+private:
+    RefPtr<NativeImage> m_image;
+};
+
+} // namespace WebCore
