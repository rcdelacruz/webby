     rootLayer->applyAnimationsRecursively(MonotonicTime::now());
+    m_rootLayer = update.rootLayer;
+    m_viewport = update.viewport;
+    m_paintsToWindow = !update.remoteContextHostedIdentifier && !m_usesOffscreenRendering;
 
     WebCore::BitmapTexture* surface = nullptr;
     RefPtr<WebCore::BitmapTexture> texture;
@@ -440,6 +443,29 @@ std::optional<UpdateInfo> WCScene::update(WCUpdateInfo&& update)
     return result;
 }
 
+void WCScene::presentSharedTexture(WebCore::PlatformLayerIdentifier layerID, uint64_t handle, uint64_t generation, const WebCore::IntSize& size)
+{
+    // Only a layer an update has already set up to show shared textures, and only a scene
+    // that is painted straight to its window; anything else waits for the next update.
+    if (!m_paintsToWindow || !m_rootLayer || !m_context || !m_context->makeContextCurrent())
+        return;
+    auto layerIterator = m_layers.find(layerID);
+    auto rootIterator = m_layers.find(*m_rootLayer);
+    if (layerIterator == m_layers.end() || rootIterator == m_layers.end())
+        return;
+    auto& layer = *layerIterator->value;
+    if (!layer.imageContents || !layer.imageContents->setSharedTexture(handle, generation, size))
+        return;
+
+    auto& rootLayer = rootIterator->value->texmapLayer;
+    rootLayer.applyAnimationsRecursively(MonotonicTime::now());
+    glViewport(0, 0, m_viewport.width(), m_viewport.height());
+    m_textureMapper->beginPainting(WebCore::TextureMapper::FlipY::No, nullptr);
+    rootLayer.paint(*m_textureMapper);
+    m_textureMapper->endPainting();
+    m_context->swapBuffers();
+}
+
 } // namespace WebKit
 
 #endif // USE(GRAPHICS_LAYER_WC)
