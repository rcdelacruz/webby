+RefPtr<WebCore::WCSharedTexturePresenter> RemoteWCLayerTreeHostProxy::createSharedTexturePresenter(WebCore::PlatformLayerIdentifier layerID)
+{
+    class Presenter final : public WebCore::WCSharedTexturePresenter {
+        WTF_DEPRECATED_MAKE_FAST_ALLOCATED(Presenter);
+    public:
+        Presenter(Ref<IPC::Connection>&& connection, WCLayerTreeHostIdentifier host, WebCore::PlatformLayerIdentifier layer)
+            : m_connection(WTF::move(connection))
+            , m_host(host)
+            , m_layer(layer)
+        {
+        }
+
+    private:
+        void present(uint64_t handle, uint64_t generation, const WebCore::IntSize& size) final
+        {
+            // IPC::Connection::send() may be called on any thread.
+            m_connection->send(Messages::RemoteWCLayerTreeHost::PresentSharedTexture(m_layer, handle, generation, size), m_host.toUInt64());
+        }
+
+        const Ref<IPC::Connection> m_connection;
+        const WCLayerTreeHostIdentifier m_host;
+        const WebCore::PlatformLayerIdentifier m_layer;
+    };
+
+    return adoptRef(*new Presenter(Ref { ensureGPUProcessConnection().connection() }, wcLayerTreeHostIdentifier(), layerID));
+}
+
 void RemoteWCLayerTreeHostProxy::update(WCUpdateInfo&& updateInfo, CompletionHandler<void(std::optional<WebKit::UpdateInfo>)>&& completionHandler)
 {
