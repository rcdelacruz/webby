+// A video frame sent from the web process's streaming thread, not as part of an update of the
+// layer tree. Shown at once: the scene is painted again as the last update left it.
+void RemoteWCLayerTreeHost::presentSharedTexture(WebCore::PlatformLayerIdentifier layer, uint64_t handle, uint64_t generation, WebCore::IntSize size)
+{
+    remoteGraphicsStreamWorkQueue().dispatch([scene = m_scene.get(), layer, handle, generation, size] {
+        scene->presentSharedTexture(layer, handle, generation, size);
+    });
+}
