+#include <wtf/Lock.h>
 #include <wtf/RefPtr.h>
+#include <wtf/ThreadSafeRefCounted.h>
 
 namespace WebCore {
 
+// Shows a shared texture in a layer of the compositor. May be called on any thread, which is
+// the point: a video frame need not wait for the main thread to be free.
+class WCSharedTexturePresenter : public ThreadSafeRefCounted<WCSharedTexturePresenter> {
+public:
+    virtual ~WCSharedTexturePresenter() = default;
+    virtual void present(uint64_t handle, uint64_t generation, const IntSize&) = 0;
+};
+
 // A layer whose contents are images WebCore hands over one at a time, such as the
 // frames of a video. The compositor shows the latest image as a texture of its own,
 // so a new frame costs one upload and no repaint of the page around it.
-// Used on the main thread only.
+// Used on the main thread only, except for presentSharedTexture().
 class WCPlatformLayerImage final : public WCPlatformLayer {
     WTF_MAKE_TZONE_ALLOCATED_INLINE(WCPlatformLayerImage);
 public:
     ~WCPlatformLayerImage()
     {
+        setPresenter(nullptr);
         if (auto* layerClient = client())
             layerClient->platformLayerWillBeDestroyed();
     }
@@ -53,7 +64,10 @@ public:
     void setImage(RefPtr<NativeImage>&& image)
     {
         m_image = WTF::move(image);
-        m_sharedTexture = { };
+        {
+            Locker locker { m_lock };
+            m_sharedTexture = { };
+        }
         if (auto* layerClient = client())
             layerClient->setPlatformLayerNeedsDisplay();
     }
@@ -71,17 +85,45 @@ public:
 
     void setSharedTexture(const SharedTexture& texture)
     {
-        m_sharedTexture = texture;
+        {
+            Locker locker { m_lock };
+            m_sharedTexture = texture;
+        }
         m_image = nullptr;
         if (auto* layerClient = client())
             layerClient->setPlatformLayerNeedsDisplay();
     }
 
-    const SharedTexture& sharedTexture() const { return m_sharedTexture; }
+    SharedTexture sharedTexture() const
+    {
+        Locker locker { m_lock };
+        return m_sharedTexture;
+    }
+
+    // Set by the graphics layer once the compositor has the layer, cleared when it lets go.
+    void setPresenter(RefPtr<WCSharedTexturePresenter>&& presenter)
+    {
+        Locker locker { m_lock };
+        m_presenter = WTF::move(presenter);
+    }
+
+    // Any thread. Shows the texture straight away if the compositor has the layer, and says
+    // whether it did; if not, the caller goes through the main thread and setSharedTexture().
+    bool presentSharedTexture(const SharedTexture& texture)
+    {
+        Locker locker { m_lock };
+        if (!m_presenter)
+            return false;
+        m_sharedTexture = texture;
+        m_presenter->present(texture.handle, texture.generation, texture.size);
+        return true;
+    }
 
 private:
     RefPtr<NativeImage> m_image;
-    SharedTexture m_sharedTexture;
+    mutable Lock m_lock;
+    SharedTexture m_sharedTexture WTF_GUARDED_BY_LOCK(m_lock);
+    RefPtr<WCSharedTexturePresenter> m_presenter WTF_GUARDED_BY_LOCK(m_lock);
 };
 
 } // namespace WebCore
